# ── MCP Server: Verification Pipeline (Stretch Goal) ─────────────────────────

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.mcp-light.txt .
RUN pip install --no-cache-dir -r requirements.mcp-light.txt

COPY src/ src/
COPY mcp_servers/ mcp_servers/

EXPOSE 8003

CMD ["python", "mcp_servers/verifier_server.py", "--transport", "http", "--port", "8003"]
