# ── MCP Server: Qdrant Retrieval ─────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch FIRST to avoid downloading CUDA/Triton GPU libs (~2GB saved)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install remaining Python dependencies
COPY requirements.mcp-qdrant.txt .
RUN pip install --no-cache-dir -r requirements.mcp-qdrant.txt

COPY src/ src/
COPY mcp_servers/ mcp_servers/

EXPOSE 8001

CMD ["python", "mcp_servers/qdrant_server.py", "--transport", "http", "--port", "8001"]
