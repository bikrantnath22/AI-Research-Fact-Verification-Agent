# ── API Keys ──
GROQ_API_KEY=
TAVILY_API_KEY=
HF_API_TOKEN=

# ── LLM Models (Groq-hosted) ──
PRIMARY_MODEL=openai/gpt-oss-20b
SECONDARY_MODEL=openai/gpt-oss-120b

# ── Qdrant ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── NLI (HuggingFace Inference API) ──
HF_NLI_MODEL=microsoft/deberta-large-mnli
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_CONTRADICTION_THRESHOLD=0.5
NLI_MAX_CONCURRENT=5                    # Max parallel HF API calls

# ── Verification Thresholds ──
RISK_THRESHOLD=0.6
MAX_RETRIES=2
RETRIEVAL_CONFIDENCE_THRESHOLD=0.5
N_ENTROPY_SAMPLES=5
ENTROPY_TEMPERATURE=0.9

# ── MCP Server URLs (Streamable HTTP transport) ──
MCP_QDRANT_URL=http://mcp-qdrant:8001/mcp
MCP_TAVILY_URL=http://mcp-tavily:8002/mcp
MCP_TRANSPORT=http                       # "http" for Docker/k3s, "stdio" for local dev
